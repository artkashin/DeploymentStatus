{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        },
        "logLevel": {
            "default": "Information",
            "DeploymentAPI": "Trace",
            "DeploymentAPI.Services": "Trace"
        }
    },
    "extensions": {
        "http": {
            "routePrefix": "api"
        }
    },
    "cors": {
        "allowCredentials": false,
        "allowedOrigins": [
            "*"
        ]
    }
}